# Data directories (chrono-harness layout). raw/ holds the fetched pages and is never
# published; log/, builds/ and runs/ are released only as the exported files in release/,
# attached to a versioned release, never through git. gold/ and registries/ ARE committed.
/raw/
/log/
/builds/
/runs/
/release/
# hydrated article texts: the outlets' copyright, never committed
/texts/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
.env
